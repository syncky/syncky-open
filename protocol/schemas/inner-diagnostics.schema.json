                  "storage",
                  "crypto",
                  "protocol",
                  "other",
                  "rate_limited",
                  "invalid_token",
                  "relay_error",
                  "healthkit_database_inaccessible",
                  "healthkit_unavailable",
                  "healthkit_authorization_exception",
                  "not_paired",
                  "busy",
                  "client_outdated",
                  "untrusted_relay",
                  "agent_key_mismatch",
                  "needs_sync_relay",
                  "agent_unconfirmed",
                  "app_attest_failed",
                  "attestation_repair_required"
