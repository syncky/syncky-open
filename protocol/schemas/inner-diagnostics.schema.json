{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/inner-diagnostics.schema.json",
  "title": "Diagnostics data inner message",
  "description": "Closed safe archive. UTF-8 input and normalized JSON at most 180000 bytes. Window at most 48 hours; events inside the window. Data envelopes only.",
  "$ref": "#/$defs/diagnostics",
  "$defs": {
    "diagnostics": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "diagnostics"
        },
        "archive_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
        },
        "request_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_at": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z(?![\\s\\S])"
        },
        "window_start": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z(?![\\s\\S])"
        },
