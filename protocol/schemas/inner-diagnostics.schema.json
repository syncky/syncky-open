              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z(?![\\s\\S])"
            },
            "relay_state": {
              "type": "string",
              "enum": [
                "notApplicable",
                "missing",
                "stale",
                "incomplete",
                "current"
              ]
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "healthUnavailable",
                      "healthSelection",
                      "healthNotRequested",
                      "healthPartial",
                      "reviewHealthAccess",
                      "lowPowerMode",
                      "backgroundRefreshOff",
                      "backgroundRefreshRestricted",
                      "notificationsDenied",
                      "settingsUnknown",
                      "lockedRun",
                      "relayUnreachable",
                      "relayEvidenceUnknown",
                      "statusUnknown",
                      "planPaused",
                      "connectionPaused",
                      "connectionNeedsAttention",
                      "serverRetrying",
                      "agentNotPolling",
                      "agentNotAcking",
                      "agentQueueBacklog",
                      "agentEvidenceUnknown",
                      "wakesNotAnswered",
                      "noRecentSuccess",
                      "neverSuccessful"
                    ]
                  },
                  "fixes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "healthAccess",
                        "healthSelection",
                        "appSettings",
                        "notificationSettings",
                        "sync",
                        "plans",
                        "refreshRelay",
                        "connection"
                      ]
                    },
                    "maxItems": 180000
                  },
                  "observed_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z(?![\\s\\S])"
                      },
