                        "type": "null"
                      }
                    ]
                  },
                  "since": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "connection": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "baseline_source": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "relayContact",
                          "localRun"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "possible_causes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "backgroundBudget",
                        "forceQuit",
                        "lowPowerMode"
                      ]
                    },
                    "maxItems": 180000
                  }
                },
                "required": [
                  "kind",
                  "fixes",
                  "possible_causes"
                ],
                "additionalProperties": false
              },
              "maxItems": 180000
            }
          },
          "required": [
            "checked_at",
            "relay_state",
            "findings"
          ],
          "additionalProperties": false
        },
        "app": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^(unknown|[0-9]+(\\.[0-9]+)*)(?![\\s\\S])",
              "maxLength": 32
            },
            "build": {
              "type": "string",
              "pattern": "^(unknown|[0-9]+(\\.[0-9]+)*)(?![\\s\\S])",
              "maxLength": 32
            },
            "os": {
              "type": "string",
              "pattern": "^(unknown|[0-9]+(\\.[0-9]+)*)(?![\\s\\S])",
              "maxLength": 32
            },
            "channel": {
              "type": "string",
              "enum": [
                "dev",
                "staging",
                "release",
                "unknown"
              ]
            }
          },
          "required": [
            "version",
            "build",
            "os",
            "channel"
          ],
          "additionalProperties": false
        },
        "pairing": {
