{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/system-event.schema.json",
  "title": "Relay system event, delivered in the same stream as data envelopes",
  "$defs": {
    "system_event": {
      "type": "object",
      "required": ["v", "kind", "seq", "msg_id", "from", "created_at", "event", "body"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "system" },
        "diagnostics": false,
        "access": false,
        "seq": { "$ref": "#/$defs/seq" },
        "msg_id": { "$ref": "#/$defs/uuidv7" },
        "from": { "type": "string", "const": "relay" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "event": { "type": "string", "enum": ["member_joined", "member_revoked", "message_expired", "hub_suspended", "hub_resumed", "hub_deleting"] },
        "body": { "type": "object" }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "member_joined" },
            "body": { "$ref": "#/$defs/member_joined_body" }
          }
        },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "member_revoked" },
            "body": { "$ref": "#/$defs/member_revoked_body" }
          }
        },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "message_expired" },
            "body": { "$ref": "#/$defs/message_expired_body" }
          }
        },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "hub_suspended" },
            "body": { "$ref": "#/$defs/hub_suspended_body" }
          }
        },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "hub_resumed" },
            "body": { "$ref": "#/$defs/hub_resumed_body" }
          }
        },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "hub_deleting" },
            "body": { "$ref": "#/$defs/hub_deleting_body" }
          }
        }
      ]
    },
    "member_joined_body": {
      "type": "object",
      "required": ["member_id", "role", "device_name", "public_key", "pairing_id"],
      "properties": {
        "member_id": { "$ref": "#/$defs/member_id" },
        "role": { "type": "string", "const": "device" },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "public_key": { "$ref": "#/$defs/b64url_32" },
        "pairing_id": { "type": "string", "pattern": "^p_[A-Za-z0-9_-]{22}$" }
      }
    },
    "member_revoked_body": {
      "type": "object",
      "required": ["member_id", "revoked_by", "self"],
      "properties": {
        "member_id": { "$ref": "#/$defs/member_id" },
        "revoked_by": { "$ref": "#/$defs/member_id" },
        "self": { "type": "boolean" }
      }
    },
    "message_expired_body": {
      "type": "object",
      "required": ["msg_id", "seq", "undelivered_to"],
      "properties": {
        "msg_id": { "$ref": "#/$defs/uuidv7" },
        "seq": { "$ref": "#/$defs/seq" },
        "undelivered_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/member_id" }
        }
      }
    },
    "hub_suspended_body": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "enum": ["subscription_expired"] }
      }
    },
    "hub_resumed_body": {
      "type": "object"
    },
    "hub_deleting_body": {
      "type": "object",
      "required": ["at"],
      "properties": {
        "at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "member_id": {
      "type": "string",
      "pattern": "^m_(agent|dev)_[1-9][0-9]{0,5}$"
    },
    "timestamp": {
      "description": "RFC 3339 accept form",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "b64url_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
