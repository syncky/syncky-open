{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/envelope.schema.json",
  "title": "Syncky client envelope (kind data or control): the client-submitted form (E10 body) and the delivered form with seq. A serialized control envelope is at most 4096 bytes, checked by the implementations",
  "$defs": {
    "submitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "msg_id", "kind", "from", "created_at", "recipients", "nonce", "ciphertext"],
      "allOf": [
        { "not": { "type": "object", "properties": { "diagnostics": true, "access": true }, "required": ["diagnostics", "access"] } },
        { "anyOf": [
          { "not": { "type": "object", "properties": { "access": true }, "required": ["access"] } },
          { "type": "object", "properties": { "kind": { "type": "string", "const": "control" } } }
        ] }
      ],
      "anyOf": [
        { "type": "object", "properties": { "kind": { "type": "string", "const": "control" }, "diagnostics": { "type": "string", "enum": ["request", "reply"] } } },
        { "type": "object", "properties": { "kind": { "type": "string", "const": "data" }, "diagnostics": { "type": "string", "const": "archive" } } }
      ],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "msg_id": { "$ref": "#/$defs/uuidv7" },
        "kind": { "type": "string", "enum": ["data", "control"] },
        "diagnostics": { "type": "string", "enum": ["request", "reply", "archive"] },
        "access": { "type": "string", "enum": ["request", "reply"] },
        "from": { "$ref": "#/$defs/member_id" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "recipients": { "$ref": "#/$defs/recipients" },
        "nonce": { "$ref": "#/$defs/b64url_12" },
        "ciphertext": { "$ref": "#/$defs/ciphertext" }
      }
    },
    "delivered": {
      "type": "object",
      "required": ["v", "msg_id", "kind", "from", "created_at", "recipients", "nonce", "ciphertext", "seq"],
      "allOf": [
        { "not": { "type": "object", "properties": { "diagnostics": true, "access": true }, "required": ["diagnostics", "access"] } },
        { "anyOf": [
          { "not": { "type": "object", "properties": { "access": true }, "required": ["access"] } },
          { "type": "object", "properties": { "kind": { "type": "string", "const": "control" } } }
        ] }
      ],
      "anyOf": [
        { "type": "object", "properties": { "kind": { "type": "string", "const": "control" }, "diagnostics": { "type": "string", "enum": ["request", "reply"] } } },
        { "type": "object", "properties": { "kind": { "type": "string", "const": "data" }, "diagnostics": { "type": "string", "const": "archive" } } }
      ],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "msg_id": { "$ref": "#/$defs/uuidv7" },
        "kind": { "type": "string", "enum": ["data", "control"] },
        "diagnostics": { "type": "string", "enum": ["request", "reply", "archive"] },
        "access": { "type": "string", "enum": ["request", "reply"] },
        "from": { "$ref": "#/$defs/member_id" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "recipients": { "$ref": "#/$defs/recipients" },
        "nonce": { "$ref": "#/$defs/b64url_12" },
        "ciphertext": { "$ref": "#/$defs/ciphertext" },
        "seq": { "$ref": "#/$defs/seq" }
      }
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/recipient" }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "enc", "wrapped_key"],
      "properties": {
        "member_id": { "$ref": "#/$defs/member_id" },
        "enc": { "$ref": "#/$defs/b64url_32" },
        "wrapped_key": { "$ref": "#/$defs/b64url_48" }
      }
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "member_id": {
      "type": "string",
      "pattern": "^m_(agent|dev)_[1-9][0-9]{0,5}$"
    },
    "timestamp": {
      "description": "RFC 3339 accept form. Calendar validity (Feb 30) is checked by the implementations, not here",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "b64url_12": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16}$"
    },
    "b64url_32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "b64url_48": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{64}$"
    },
    "ciphertext": {
      "description": "base64url of at least 16 bytes (ct || tag16); a length of 1 mod 4 is impossible",
      "type": "string",
      "minLength": 22,
      "pattern": "^([A-Za-z0-9_-]{4})*([A-Za-z0-9_-]{2,3})?$"
    }
  }
}
