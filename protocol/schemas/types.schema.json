{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/types.schema.json",
  "title": "protocol/types.json, the canonical type catalog generated by the KMP core",
  "$defs": {
    "types_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_version", "generated_by", "types", "workout", "characteristics"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "protocol_version": { "type": "integer", "const": 1 },
        "generated_by": { "type": "string", "const": "syncky-core TypeCatalog (do not edit)" },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/quantity_type" },
              { "$ref": "#/$defs/category_type" },
              { "$ref": "#/$defs/object_kind_type" }
            ]
          }
        },
        "workout": { "$ref": "#/$defs/workout" },
        "characteristics": {
          "type": "array",
          "items": { "$ref": "#/$defs/characteristic" }
        }
      }
    },
    "quantity_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "hk", "unit", "aggregation", "write", "computed_by_apple", "hc", "hc_mapping"],
      "properties": {
        "name": { "$ref": "#/$defs/type_name" },
        "kind": { "type": "string", "const": "quantity" },
        "hk": { "type": "string", "pattern": "^HKQuantityTypeIdentifier[A-Za-z0-9]+$" },
        "unit": { "type": "string", "minLength": 1 },
        "aggregation": { "type": "string", "enum": ["cumulative", "discrete"] },
        "write": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "max_span_s": { "type": "integer", "minimum": 0 },
        "computed_by_apple": { "type": "boolean" },
        "hc": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Za-z]+Record$" }, { "type": "null" }] },
        "hc_mapping": { "type": "string", "enum": ["one_to_one", "lossy", "none"] }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "write": { "type": "boolean", "const": true } } },
          "then": {
            "type": "object",
            "properties": { "min": { "type": "number" }, "max": { "anyOf": [{ "type": "number" }, { "type": "null" }] } },
            "required": ["min", "max"]
          }
        },
        { "$ref": "#/$defs/computed_is_read_only" },
        { "$ref": "#/$defs/hc_consistency" }
      ]
    },
    "category_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "hk", "values", "write", "computed_by_apple", "hc", "hc_mapping"],
      "properties": {
        "name": { "$ref": "#/$defs/type_name" },
        "kind": { "type": "string", "const": "category" },
        "hk": { "type": "string", "pattern": "^HKCategoryTypeIdentifier[A-Za-z0-9]+$" },
        "values": { "$ref": "#/$defs/named_values" },
        "write": { "type": "boolean" },
        "max_span_s": { "type": "integer", "minimum": 0 },
        "computed_by_apple": { "type": "boolean" },
        "hc": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Za-z]+Record$" }, { "type": "null" }] },
        "hc_mapping": { "type": "string", "enum": ["one_to_one", "lossy", "none"] }
      },
      "allOf": [
        { "$ref": "#/$defs/computed_is_read_only" },
        { "$ref": "#/$defs/hc_consistency" }
      ]
    },
    "object_kind_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "hk", "write", "computed_by_apple", "hc", "hc_mapping", "enums"],
      "properties": {
        "name": { "$ref": "#/$defs/type_name" },
        "kind": {
          "type": "string",
          "enum": ["state_of_mind", "activity_summary", "scored_assessment", "audiogram", "workout_route", "heartbeat_series"]
        },
        "hk": { "type": "string", "pattern": "^HK[A-Za-z0-9]*Identifier[A-Za-z0-9]*$|^HKObjectType\\.[a-zA-Z]+\\(\\)$" },
        "write": { "type": "boolean", "const": false },
        "computed_by_apple": { "type": "boolean" },
        "hc": { "type": "null" },
        "hc_mapping": { "type": "string", "const": "none" },
        "enums": { "$ref": "#/$defs/enums" }
      }
    },
    "enums": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/named_values" }
    },
    "computed_is_read_only": {
      "type": "object",
      "properties": {
        "write": { "type": "boolean" },
        "computed_by_apple": { "type": "boolean" }
      },
      "if": { "type": "object", "properties": { "computed_by_apple": { "type": "boolean", "const": true } } },
      "then": { "type": "object", "properties": { "write": { "type": "boolean", "const": false } } }
    },
    "hc_consistency": {
      "type": "object",
      "properties": {
        "hc": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "hc_mapping": { "type": "string" }
      },
      "if": { "type": "object", "properties": { "hc": { "type": "null" } } },
      "then": { "type": "object", "properties": { "hc_mapping": { "type": "string", "const": "none" } } },
      "else": { "type": "object", "properties": { "hc_mapping": { "type": "string", "enum": ["one_to_one", "lossy"] } } }
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hk", "write", "activities", "enums"],
      "properties": {
        "hk": { "type": "string", "const": "HKWorkoutTypeIdentifier" },
        "write": { "type": "boolean", "const": false },
        "activities": { "$ref": "#/$defs/named_values" },
        "enums": { "$ref": "#/$defs/enums" }
      }
    },
    "characteristic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hk", "format"],
      "properties": {
        "name": { "$ref": "#/$defs/type_name" },
        "hk": { "type": "string", "pattern": "^HKCharacteristicTypeIdentifier[A-Za-z0-9]+$" },
        "format": { "type": "string", "enum": ["date", "enum"] },
        "values": { "$ref": "#/$defs/named_values" }
      },
      "if": { "type": "object", "properties": { "format": { "type": "string", "const": "enum" } } },
      "then": { "type": "object", "properties": { "values": { "type": "array" } }, "required": ["values"] },
      "else": { "type": "object", "not": { "type": "object", "properties": { "values": true }, "required": ["values"] } }
    },
    "named_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hk_raw"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "hk_raw": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "type_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    }
  }
}
