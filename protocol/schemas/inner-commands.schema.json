{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/inner-commands.schema.json",
  "title": "Inner protocol v1, agent to phone: the canonical emitted commands message. Unknown fields are allowed",
  "$defs": {
    "commands": {
      "type": "object",
      "required": ["v", "type", "commands"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "commands" },
        "commands": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/command_write" },
              { "$ref": "#/$defs/command_delete" }
            ]
          }
        }
      }
    },
    "command_write": {
      "description": "a quantity write carries a number value and a unit; a category write carries a string value and no unit",
      "type": "object",
      "required": ["command_id", "version", "op", "type", "value", "start", "end"],
      "properties": {
        "command_id": { "$ref": "#/$defs/command_id" },
        "version": { "$ref": "#/$defs/version" },
        "op": { "type": "string", "const": "write" },
        "type": { "$ref": "#/$defs/type_name" },
        "value": { "anyOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
        "unit": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/timestamp" },
        "end": { "$ref": "#/$defs/timestamp" }
      },
      "if": { "type": "object", "properties": { "value": { "type": "number" } } },
      "then": { "type": "object", "properties": { "unit": { "type": "string" } }, "required": ["unit"] },
      "else": { "type": "object", "not": { "type": "object", "properties": { "unit": true }, "required": ["unit"] } }
    },
    "command_delete": {
      "type": "object",
      "required": ["command_id", "version", "op", "type"],
      "properties": {
        "command_id": { "$ref": "#/$defs/command_id" },
        "version": { "$ref": "#/$defs/version" },
        "op": { "type": "string", "const": "delete" },
        "type": { "$ref": "#/$defs/type_name" }
      }
    },
    "type_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "description": "RFC 3339 emit form",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.([1-9][0-9]{2}|0[1-9][0-9]|00[1-9]))?Z$"
    }
  }
}
