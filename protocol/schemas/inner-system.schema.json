{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/inner-system.schema.json",
  "title": "Inner protocol v1, system messages inside a control envelope: the canonical emitted form. Named types have exactly their keys; another type matching ^[a-z_]{1,32}$ is skipped by receivers as unknown_system_type",
  "$defs": {
    "system": {
      "oneOf": [
        { "$ref": "#/$defs/unpair" },
        { "$ref": "#/$defs/paused" },
        { "$ref": "#/$defs/resumed" },
        { "$ref": "#/$defs/confirmed" },
        { "$ref": "#/$defs/unpaired" },
        { "$ref": "#/$defs/resync_request" },
        { "$ref": "#/$defs/agent_info" },
        { "$ref": "#/$defs/pair_proof" },
        { "$ref": "#/$defs/diagnostics_request" },
        { "$ref": "#/$defs/diagnostics_reply" },
        { "$ref": "#/$defs/access_request" },
        { "$ref": "#/$defs/access_reply" },
        { "$ref": "#/$defs/scope_release" },
        { "$ref": "#/$defs/unknown" }
      ]
    },
    "unpair": {
      "description": "phone to agent: this phone leaves the hub",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "reason"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "unpair" },
        "reason": { "type": "string", "enum": ["user", "reset", "replaced", "delete_relay_data"] }
      }
    },
    "paused": {
      "description": "phone to agent: uploads and command application stop until resumed",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "reason"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "paused" },
        "reason": { "type": "string", "enum": ["subscription_ended", "user_paused", "health_access_changed"] }
      }
    },
    "resumed": {
      "description": "phone to agent",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "resumed" }
      }
    },
    "confirmed": {
      "description": "agent to phone: the owner confirmed this phone's fingerprint on the agent",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "confirmed" }
      }
    },
    "unpaired": {
      "description": "agent to phone: the agent no longer takes this phone",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "reason"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "unpaired" },
        "reason": { "type": "string", "enum": ["user", "reset", "replaced"] }
      }
    },
    "resync_request": {
      "description": "agent to phone: send again what changed since from",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "from"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "resync_request" },
        "from": { "$ref": "#/$defs/timestamp" }
      }
    },
    "agent_info": {
      "description": "agent to phone",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "version"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "agent_info" },
        "version": { "type": "string", "pattern": "^[0-9A-Za-z.+_-]{1,64}$" }
      }
    },
    "scope_release": {
      "description": "agent to phone: the agent gives up Health types it no longer needs; the phone narrows this agent's access at once and sends no reply, the scope of the next sync message shows the result. At least one name; a name outside the catalog, or a write name that is not writable, makes the message invalid",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "read", "write"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "scope_release" },
        "read": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" } },
        "write": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" } }
      },
      "anyOf": [
        { "type": "object", "properties": { "read": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "write": { "type": "array", "minItems": 1 } } }
      ]
    },
    "pair_proof": {
      "description": "phone to agent: HMAC-SHA256 keyed by the pairing secret of the v2 link over the agent and device keys",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "proof"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "pair_proof" },
        "proof": { "type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" }
      }
    },
    "diagnostics_request": {
      "description": "agent to phone; exactly 24 hours from creation",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "request_ref", "created_at", "expires_at"],
      "properties": {
        "v": {"type": "integer", "const": 1},
        "type": {"type": "string", "const": "diagnostics_request"},
        "request_ref": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "diagnostics_reply": {
      "description": "phone to requesting agent; decision-based retries for 48 hours",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "request_ref", "outcome", "reason"],
      "properties": {
        "v": {"type": "integer", "const": 1},
        "type": {"type": "string", "const": "diagnostics_reply"},
        "request_ref": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "outcome": {"type": "string", "enum": ["declined", "expired"]},
        "reason": {"type": "string", "enum": ["user", "pending_limit", "rate_limited", "deadline"]}
      },
      "oneOf": [
        {"type": "object", "properties": {"outcome": {"type": "string", "const": "declined"}, "reason": {"type": "string", "enum": ["user", "pending_limit", "rate_limited"]}}},
        {"type": "object", "properties": {"outcome": {"type": "string", "const": "expired"}, "reason": {"type": "string", "const": "deadline"}}}
      ]
    },
    "access_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "request_ref",
        "created_at",
        "expires_at",
        "read",
        "write"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "access_request"
        },
        "request_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "write": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "access_timestamp": {
      "allOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "string",
          "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})-"
        }
      ]
    },
    "access_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "outcome"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "allowed",
            "declined",
            "needs_health_settings",
            "refused"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "requested_recently",
            "declined_recently"
          ]
        },
        "next_available_at": {
          "$ref": "#/$defs/access_timestamp"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "allowed",
                "declined",
                "needs_health_settings"
              ]
            },
            "reason": false,
            "next_available_at": false
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "next_available_at"
          ],
          "properties": {
            "outcome": {
              "const": "refused"
            },
            "reason": true,
            "next_available_at": true
          }
        }
      ]
    },
    "access_reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "request_ref",
        "decided_at",
        "outcome",
        "read",
        "write"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "access_reply"
        },
        "request_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "resolved",
            "expired",
            "pending_limit",
            "rate_limited",
            "invalid",
            "filtered",
            "merged"
          ]
        },
        "read": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/access_item"
          }
        },
        "write": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/access_item"
          }
        },
        "next_available_at": {
          "$ref": "#/$defs/timestamp"
        },
        "detail": {
          "type": "string",
          "enum": [
            "unknown_type",
            "not_writable",
            "ttl",
            "empty",
            "reason_too_long",
            "malformed",
            "created_in_future",
            "too_large"
          ]
        },
        "limit_reason": {
          "type": "string",
          "enum": [
            "daily_ceiling",
            "amendment_limit"
          ]
        },
        "merged_into": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "merged_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "description": "Sorted unique aliases excluding request_ref; Kotlin also checks order and root/alias identity."
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "resolved"
              ]
            },
            "next_available_at": false,
            "detail": false,
            "limit_reason": false,
            "merged_into": false
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "read": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "outcome": {
                        "enum": [
                          "allowed",
                          "declined",
                          "needs_health_settings"
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "write": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "outcome": {
                        "enum": [
                          "allowed",
                          "declined",
                          "needs_health_settings"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "expired"
              ]
            },
            "next_available_at": false,
            "detail": false,
            "limit_reason": false,
            "merged_into": false,
            "read": {
              "type": "array",
              "maxItems": 0
            },
            "write": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "invalid"
              ]
            },
            "next_available_at": false,
            "limit_reason": false,
            "merged_into": false,
            "merged_refs": false,
            "read": {
              "type": "array",
              "maxItems": 0
            },
            "write": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "pending_limit"
              ]
            },
            "detail": false,
            "limit_reason": false,
            "merged_into": false,
            "merged_refs": false,
            "read": {
              "type": "array",
              "maxItems": 0
            },
            "write": {
              "type": "array",
              "maxItems": 0
            },
            "next_available_at": true
          },
          "required": [
            "next_available_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "rate_limited"
              ]
            },
            "detail": false,
            "merged_into": false,
            "merged_refs": false,
            "read": {
              "type": "array",
              "maxItems": 0
            },
            "write": {
              "type": "array",
              "maxItems": 0
            },
            "next_available_at": true
          },
          "required": [
            "next_available_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "filtered"
              ]
            },
            "next_available_at": false,
            "detail": false,
            "limit_reason": false,
            "merged_into": false,
            "merged_refs": false,
            "read": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "refused"
                  }
                }
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "refused"
                  }
                }
              }
            }
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "read": {
                  "type": "array",
                  "minItems": 1
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "write": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "merged"
              ]
            },
            "next_available_at": false,
            "detail": false,
            "limit_reason": false,
            "merged_refs": false,
            "read": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "refused"
                  }
                }
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "refused"
                  }
                }
              }
            },
            "merged_into": true
          },
          "required": [
            "merged_into"
          ]
        }
      ]
    },
    "unknown": {
      "description": "the normalized form of a type this version does not know",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type"],
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "type": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$",
          "not": { "type": "string", "enum": ["unpair", "paused", "resumed", "confirmed", "unpaired", "resync_request", "agent_info", "pair_proof", "sync", "commands", "diagnostics", "diagnostics_request", "diagnostics_reply", "access_request", "access_reply", "scope_release"] }
        }
      }
    },
    "timestamp": {
      "description": "RFC 3339 emit form: UTC, uppercase T and Z, no fraction when the milliseconds are 0, otherwise exactly 3 digits",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.([1-9][0-9]{2}|0[1-9][0-9]|00[1-9]))?Z$"
    }
  }
}
