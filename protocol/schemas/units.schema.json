{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncky.app/protocol/schemas/units.schema.json",
  "title": "protocol/units.json, the unit conversion table generated by the KMP core",
  "description": "A quantity write may use any unit of the family that holds the type's canonical unit (types.json `unit`). A unit belongs to exactly one family. Convert with canonical = ((value * from.factor + from.offset) - to.offset) / to.factor in IEEE double arithmetic, in that order; when the unit is already canonical the value is used unchanged. `base` names the reference unit the factors count in; it is accepted only when it is also listed in `units`.",
  "$defs": {
    "units_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_version", "generated_by", "families"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "protocol_version": { "type": "integer", "const": 1 },
        "generated_by": { "type": "string", "const": "syncky-core UnitConversions (do not edit)" },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family" }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base", "units"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "base": { "type": "string", "minLength": 1 },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/unit" }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "factor", "offset"],
      "properties": {
        "unit": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "factor": { "type": "number", "exclusiveMinimum": 0 },
        "offset": { "type": "number" }
      }
    }
  }
}
