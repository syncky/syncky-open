{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.syncky/syncky-health",
  "title": "Syncky Health",
  "description": "Apple Health data, end-to-end encrypted between iPhone and local Syncky agent, allowed write-back",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/syncky/syncky-open",
    "source": "github"
  },
  "websiteUrl": "https://syncky.app/agents",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@syncky/agent",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "transport": { "type": "stdio" }
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/syncky/syncky-open/releases/download/v0.1.2/syncky-health.mcpb",
      "transport": { "type": "stdio" }
    }
  ]
}
